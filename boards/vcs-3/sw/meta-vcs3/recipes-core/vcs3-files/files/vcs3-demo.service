[Unit]
Description=VCS-3 dual-camera display demo
After=systemd-udev-trigger.service

[Service]
Type=simple
ExecStart=/usr/bin/vcs3-demo
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
